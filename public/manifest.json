{
  "manifest_version": 3,
  "name": "DarkLens",
  "version": "1.0.0",
  "description": "See what websites are trying to make you do.",
  "action": { "default_popup": "popup.html", "default_title": "DarkLens", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "src/background/index.js", "type": "module" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["src/content/index.js"], "run_at": "document_idle" }],
  "side_panel": { "default_path": "sidepanel.html" }, "options_page": "options.html",
  "permissions": ["activeTab", "storage", "sidePanel"], "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
